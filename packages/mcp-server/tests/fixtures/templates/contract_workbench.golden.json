[
  {
    "version": "v1.0",
    "createSurface": {
      "surfaceId": "contract_workbench",
      "sendDataModel": true,
      "components": [
        {
          "id": "root",
          "component": "Card",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "contract_col"
        },
        {
          "id": "contract_col",
          "component": "Column",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "contract_title",
            "preview_text",
            "contract_top_divider",
            "fields_row",
            "picks_row",
            "flags_row",
            "contract_bottom_divider",
            "contract_footer"
          ]
        },
        {
          "id": "contract_title",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/title"
          }
        },
        {
          "id": "preview_text",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@call": "formatString",
            "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
            "args": {
              "value": "**Preview:** `POST ${/contract/route}` | **Event:** `${/contract/eventName}` | **Timeout:** `${/contract/timeoutSec}s`"
            }
          }
        },
        {
          "id": "contract_top_divider",
          "component": "Divider",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
        },
        {
          "id": "fields_row",
          "component": "Row",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "route_field",
            "event_field"
          ]
        },
        {
          "id": "route_field",
          "component": "TextField",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "label": {
            "@path": "/labels/route"
          },
          "value": {
            "@path": "/contract/route"
          },
          "weight": 1,
          "checks": [
            {
              "condition": {
                "@call": "required",
                "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
                "args": {
                  "value": {
                    "@path": "/contract/route"
                  }
                }
              },
              "message": "Route is required"
            },
            {
              "condition": {
                "@call": "regex",
                "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
                "args": {
                  "value": {
                    "@path": "/contract/route"
                  },
                  "pattern": "^/[a-z0-9/_-]+$"
                }
              },
              "message": "Must start with / and use lowercase slug characters"
            }
          ]
        },
        {
          "id": "event_field",
          "component": "TextField",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "label": {
            "@path": "/labels/eventName"
          },
          "value": {
            "@path": "/contract/eventName"
          },
          "weight": 1,
          "checks": [
            {
              "condition": {
                "@call": "required",
                "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
                "args": {
                  "value": {
                    "@path": "/contract/eventName"
                  }
                }
              },
              "message": "Event name is required"
            },
            {
              "condition": {
                "@call": "regex",
                "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
                "args": {
                  "value": {
                    "@path": "/contract/eventName"
                  },
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "message": "Must be a snake_case identifier"
            }
          ]
        },
        {
          "id": "picks_row",
          "component": "Row",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "wire_format_picker",
            "timeout_slider"
          ]
        },
        {
          "id": "wire_format_picker",
          "component": "ChoicePicker",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "label": {
            "@path": "/labels/wireFormat"
          },
          "variant": "mutuallyExclusive",
          "options": [
            {
              "label": "JSON-RPC 2.0",
              "value": "jsonrpc"
            },
            {
              "label": "Flat Action Envelope",
              "value": "flat_envelope"
            },
            {
              "label": "NDJSON Stream",
              "value": "ndjson"
            }
          ],
          "value": {
            "@path": "/contract/wireFormat"
          },
          "displayStyle": "chips",
          "weight": 1
        },
        {
          "id": "timeout_slider",
          "component": "Slider",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "label": {
            "@path": "/labels/timeout"
          },
          "min": 5,
          "max": 300,
          "value": {
            "@path": "/contract/timeoutSec"
          },
          "steps": 1
        },
        {
          "id": "flags_row",
          "component": "Row",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "idempotent_check",
            "include_model_check"
          ]
        },
        {
          "id": "idempotent_check",
          "component": "CheckBox",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "label": {
            "@path": "/labels/idempotent"
          },
          "value": {
            "@path": "/contract/idempotent"
          },
          "weight": 1
        },
        {
          "id": "include_model_check",
          "component": "CheckBox",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "label": {
            "@path": "/labels/includeDataModel"
          },
          "value": {
            "@path": "/contract/includeDataModel"
          },
          "weight": 1
        },
        {
          "id": "contract_bottom_divider",
          "component": "Divider",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
        },
        {
          "id": "contract_footer",
          "component": "Row",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "submit_btn"
          ],
          "justify": "end",
          "align": "center"
        },
        {
          "id": "submit_btn",
          "component": "Button",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "submit_btn_child",
          "variant": "primary",
          "action": {
            "event": {
              "name": "approve_contract",
              "context": {
                "contract": {
                  "@path": "/contract"
                }
              }
            }
          },
          "checks": [
            {
              "condition": {
                "@call": "required",
                "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
                "args": {
                  "value": {
                    "@path": "/contract/route"
                  }
                }
              },
              "message": "Route is required"
            },
            {
              "condition": {
                "@call": "required",
                "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
                "args": {
                  "value": {
                    "@path": "/contract/eventName"
                  }
                }
              },
              "message": "Event name is required"
            }
          ]
        },
        {
          "id": "submit_btn_child",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/submitLabel"
          }
        }
      ],
      "dataModel": {
        "title": "### Template 2: API & Schema Contract Workbench",
        "contract": {
          "route": "/_sidecar/send-message",
          "eventName": "submit_alignment",
          "wireFormat": [
            "flat_envelope"
          ],
          "timeoutSec": 120,
          "idempotent": true,
          "includeDataModel": true
        },
        "labels": {
          "route": "Sidecar Endpoint Route",
          "eventName": "Action Event Name",
          "wireFormat": "Payload Envelope Format",
          "timeout": "Await Timeout (seconds)",
          "idempotent": "Require idempotency key header",
          "includeDataModel": "Attach full client dataModel snapshot"
        },
        "submitLabel": "Approve API Contract"
      }
    }
  }
]
