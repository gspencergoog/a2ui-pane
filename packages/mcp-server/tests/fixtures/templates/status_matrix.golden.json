[
  {
    "version": "v1.0",
    "createSurface": {
      "surfaceId": "status_matrix",
      "sendDataModel": true,
      "components": [
        {
          "id": "root",
          "component": "Card",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "matrix_col"
        },
        {
          "id": "matrix_col",
          "component": "Column",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "matrix_title",
            "matrix_intro",
            "legend",
            "matrix_table",
            "matrix_footer"
          ]
        },
        {
          "id": "matrix_title",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/title"
          }
        },
        {
          "id": "matrix_intro",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/intro"
          },
          "variant": "caption"
        },
        {
          "id": "legend",
          "component": "List",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": {
            "path": "/legend",
            "componentId": "legend_badge"
          },
          "direction": "horizontal"
        },
        {
          "id": "legend_badge",
          "component": "Badge",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/status/catalog.json",
          "text": {
            "@path": "text"
          },
          "tone": {
            "@path": "tone"
          }
        },
        {
          "id": "matrix_table",
          "component": "Table",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/status/catalog.json",
          "columns": [
            {
              "key": "label",
              "label": "Suite"
            },
            {
              "key": "c1",
              "label": "Python",
              "kind": "badge"
            },
            {
              "key": "c2",
              "label": "TypeScript",
              "kind": "badge"
            },
            {
              "key": "c3",
              "label": "Dart",
              "kind": "badge"
            },
            {
              "key": "c4",
              "label": "Swift",
              "kind": "badge"
            }
          ],
          "rows": {
            "@path": "/rows"
          },
          "dense": true
        },
        {
          "id": "matrix_footer",
          "component": "Row",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "ack_btn"
          ],
          "justify": "end",
          "align": "center"
        },
        {
          "id": "ack_btn",
          "component": "Button",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "ack_btn_child",
          "action": {
            "event": {
              "name": "acknowledge_status_matrix",
              "context": {
                "_oneShot": true
              }
            }
          }
        },
        {
          "id": "ack_btn_child",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/ackLabel"
          }
        }
      ],
      "dataModel": {
