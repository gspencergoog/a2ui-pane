$/question = "**Context**: `OrderRepository` writes only to `legacy_orders`. Which cutover strategy should we use for `orders_v2`?"
$/options = [{title: "**A: Dual-Write + Shadow Reads (Recommended)**", badge: "Zero downtime", tone: "success", impact: "**Consequences of this decision:**\n- Touches 3 adapter files.\n- Keeps writes live during cutover.", tradeoff: "Tradeoff: temporary shadow-diff logging ($< 2\\text{ms}$ p99)."}, {title: "**B: In-Place Maintenance Cutover**", badge: "15m write freeze", tone: "warning", impact: "**Consequences of this decision:**\n- Single migration script.\n- Blocks writes during table swap.", tradeoff: "Tradeoff: 15-minute write freeze during deploy."}]
$/traceTitle = "Affected files & blast radius"
$/traceSummary = "3 files"
$/trace = "- `src/orders/repository.ts`\n- `src/orders/shadow-reader.ts`\n- `migrations/042_orders_v2.sql`"
$/choice = ["dual_write"]
choice_picker = ChoicePicker("Select cutover strategy", "mutuallyExclusive", [{label: "A: Dual-Write (Recommended)", value: "dual_write"}, {label: "B: In-Place Cutover", value: "cutover"}], $/choice, "chips")
