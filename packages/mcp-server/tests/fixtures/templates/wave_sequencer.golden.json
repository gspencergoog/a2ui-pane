          },
          "variant": "caption"
        },
        {
          "id": "seq_top_divider",
          "component": "Divider"
        },
        {
          "id": "seq_task_list",
          "component": "List",
          "children": {
            "path": "/tasks",
            "componentId": "seq_task_card"
          }
        },
        {
          "id": "seq_task_card",
          "component": "Card",
          "child": "seq_task_col"
        },
        {
          "id": "seq_task_col",
          "component": "Column",
          "children": [
            "seq_task_title",
            "seq_task_deps",
            "wave_picker",
            "verification_picker",
            "seq_task_note"
          ]
        },
        {
          "id": "seq_task_title",
          "component": "Text",
          "text": {
            "path": "title"
          },
          "variant": "h4"
        },
        {
          "id": "seq_task_deps",
          "component": "Text",
          "text": {
            "path": "dependsOn"
          },
          "variant": "caption"
        },
        {
          "id": "wave_picker",
          "component": "ChoicePicker",
          "label": "Delivery wave",
          "variant": "mutuallyExclusive",
          "options": [
            {
              "label": "🌊 Wave 1 (Foundation)",
              "value": "wave1"
            },
            {
              "label": "🌊 Wave 2 (Core)",
              "value": "wave2"
            },
            {
              "label": "🌊 Wave 3 (Polish)",
              "value": "wave3"
            },
            {
              "label": "⏸️ Defer",
              "value": "defer"
            }
          ],
          "value": {
            "path": "wave"
          },
          "displayStyle": "chips"
        },
        {
          "id": "verification_picker",
          "component": "ChoicePicker",
          "label": "Verification gate",
          "variant": "multipleSelection",
          "options": [
            {
              "label": "Unit tests",
              "value": "unit"
            },
            {
              "label": "Integration + harness",
              "value": "integration"
            },
            {
              "label": "Manual UI check",
              "value": "manual"
            }
          ],
          "value": {
            "path": "verification"
          },
          "displayStyle": "chips"
        },
        {
          "id": "seq_task_note",
          "component": "TextField",
          "label": "Sequencing constraint or owner note",
          "value": {
            "path": "note"
          }
        },
        {
          "id": "seq_bottom_divider",
          "component": "Divider"
        },
        {
          "id": "seq_footer",
          "component": "Row",
          "children": [
            "submit_btn"
          ],
          "justify": "end",
          "align": "center"
        },
        {
          "id": "submit_label",
          "component": "Text",
          "text": {
            "path": "/submitLabel"
          }
        },
        {
          "id": "submit_btn",
          "component": "Button",
          "child": "submit_label",
          "variant": "primary",
          "action": {
            "event": {
              "name": "submit_wave_sequence",
              "context": {
                "global": {
                  "path": "/global"
                },
                "tasks": {
                  "path": "/tasks"
                }
              }
            }
          }
        }
      ]
    }
  },
