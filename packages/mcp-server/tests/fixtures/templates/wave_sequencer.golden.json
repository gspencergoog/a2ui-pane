          "id": "root",
          "component": "Card",
          "child": "seq_col"
        },
        {
          "id": "seq_col",
          "component": "Column",
          "children": [
            "seq_title",
            "seq_intro",
            "seq_dag",
            "rollout_badge",
            "seq_top_divider",
            "seq_task_list",
            "seq_bottom_divider",
            "seq_footer"
          ]
        },
        {
          "id": "seq_title",
          "component": "Text",
          "text": {
            "path": "/title"
          }
        },
        {
          "id": "seq_intro",
          "component": "Text",
          "text": {
            "path": "/intro"
          },
          "variant": "caption"
        },
        {
          "id": "seq_dag",
          "component": "Text",
          "text": {
            "path": "/dag"
          }
        },
        {
          "id": "rollout_badge",
          "component": "Text",
          "text": {
            "call": "formatString",
            "args": {
              "value": "**Rollout strategy:** `${/global/rolloutMode}` | **Coverage gate:** `${/global/coverageGate}%`"
