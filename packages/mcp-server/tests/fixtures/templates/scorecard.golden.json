[
  {
    "version": "v1.0",
    "createSurface": {
      "surfaceId": "scorecard",
      "sendDataModel": true,
      "components": [
        {
          "id": "root",
          "component": "Card",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "score_col"
        },
        {
          "id": "score_col",
          "component": "Column",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "score_title",
            "score_intro",
            "overall_bar",
            "score_divider",
            "score_rows",
            "score_note",
            "score_footer"
          ]
        },
        {
          "id": "score_title",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/title"
          }
        },
        {
          "id": "score_intro",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/intro"
          },
          "variant": "caption"
        },
        {
          "id": "overall_bar",
          "component": "ProgressBar",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/status/catalog.json",
          "value": {
            "@path": "/overall/score"
          },
          "max": {
            "@path": "/overall/max"
          },
          "label": "Overall",
          "summary": {
            "@call": "formatString",
            "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
            "args": {
              "value": "${/overall/score} / ${/overall/max}"
            }
          }
        },
        {
          "id": "score_divider",
          "component": "Divider",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
        },
        {
          "id": "score_rows",
          "component": "List",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": {
            "path": "/rows",
            "componentId": "score_row"
          }
        },
        {
          "id": "score_row",
          "component": "Row",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "score_row_body",
            "score_row_bar",
            "score_row_badge"
          ],
          "align": "center"
        },
        {
          "id": "score_row_body",
          "component": "Column",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "score_row_label",
            "score_row_rationale"
          ],
          "weight": 3
        },
        {
          "id": "score_row_label",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "label"
          }
        },
        {
          "id": "score_row_rationale",
          "component": "Collapsible",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/status/catalog.json",
          "title": "Rationale",
          "child": "score_row_rationale_text"
        },
        {
          "id": "score_row_rationale_text",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "rationale"
          },
          "variant": "caption"
        },
        {
          "id": "score_row_bar",
          "component": "ProgressBar",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/status/catalog.json",
          "value": {
            "@path": "score"
          },
          "max": {
            "@path": "max"
          },
          "weight": 2
        },
        {
          "id": "score_row_badge",
          "component": "Badge",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/status/catalog.json",
          "text": {
            "@call": "formatString",
            "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
            "args": {
              "value": "${score}/${max}"
            }
          },
          "tone": {
            "@path": "tone"
          }
        },
        {
          "id": "score_note",
          "component": "TextField",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "label": "Notes",
          "value": {
            "@path": "/note"
          }
        },
        {
          "id": "score_footer",
          "component": "Row",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "submit_btn"
          ],
          "justify": "end",
          "align": "center"
        },
        {
          "id": "submit_btn",
          "component": "Button",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "submit_btn_child",
          "variant": "primary",
          "action": {
            "event": {
              "name": "submit_scorecard",
              "context": {
                "rows": {
                  "@path": "/rows"
                },
                "note": {
                  "@path": "/note"
                },
                "_oneShot": false
              }
            }
          }
        },
        {
          "id": "submit_btn_child",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/submitLabel"
          }
        }
      ],
      "dataModel": {
        "title": "### API review: `StoreWriter`",
        "intro": "Scores are out of 10. Open Rationale on any row for the evidence behind its score.",
        "overall": {
          "score": 6.6,
          "max": 10
        },
        "rows": [
          {
            "label": "Contract-first interface",
            "score": 9,
            "max": 10,
            "tone": "success",
            "rationale": "`StoreWriter` exposes `append`, `flush`, and `close` and nothing else; callers cannot reach the buffer."
          },
          {
            "label": "KISS and YAGNI",
            "score": 8,
            "max": 10,
            "tone": "success",
            "rationale": "No speculative options; the only knob is `maxBufferBytes`, which two callers already set."
          },
          {
            "label": "Intent-revealing names",
            "score": 6,
            "max": 10,
            "tone": "warning",
            "rationale": "`append` and `flush` read well, but `sync2` hides that it blocks on fsync."
          },
          {
            "label": "Command-query separation",
            "score": 7,
            "max": 10,
            "tone": "warning",
            "rationale": "`append` returns the new offset, which is a query result from a command."
          },
          {
            "label": "Strict types over strings",
            "score": 3,
            "max": 10,
            "tone": "danger",
            "rationale": "`mode` is a free-form string (`\"append\"`, `\"truncate\"`) checked at runtime; an enum would catch typos at compile time."
          }
        ],
        "note": "",
        "submitLabel": "Accept scores"
      }
    }
  }
]
