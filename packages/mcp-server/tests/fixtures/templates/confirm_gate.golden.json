[
  {
    "version": "v1.0",
    "createSurface": {
      "surfaceId": "confirm_gate",
      "sendDataModel": true,
      "components": [
        {
          "id": "root",
          "component": "Card",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "gate_col"
        },
        {
          "id": "gate_col",
          "component": "Column",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "gate_title",
            "gate_summary",
            "gate_divider",
            "confirm_check",
            "gate_footer"
          ]
        },
        {
          "id": "gate_title",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/title"
          }
        },
        {
          "id": "gate_summary",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/summary"
          }
        },
        {
          "id": "gate_divider",
          "component": "Divider",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
        },
        {
          "id": "confirm_check",
          "component": "CheckBox",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "label": {
            "@path": "/confirmLabel"
          },
          "value": {
            "@path": "/confirmed"
          }
        },
        {
          "id": "gate_footer",
          "component": "Row",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "cancel_btn",
            "confirm_btn"
          ],
          "justify": "end",
          "align": "center"
        },
        {
          "id": "cancel_btn",
          "component": "Button",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "cancel_btn_child",
          "action": {
            "event": {
              "name": "cancel_confirm_gate"
            }
          }
        },
        {
          "id": "cancel_btn_child",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/cancelLabel"
          }
        },
        {
          "id": "confirm_btn",
          "component": "Button",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "confirm_btn_child",
          "variant": "primary",
          "action": {
            "event": {
              "name": "confirm_gate",
              "context": {
                "confirmed": {
                  "@path": "/confirmed"
                }
              }
            }
          },
          "checks": [
            {
              "condition": {
                "@call": "and",
                "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
                "args": {
                  "values": [
                    {
                      "@path": "/confirmed"
                    },
                    true
                  ]
                }
              },
              "message": "Tick the acknowledgement first"
            }
          ]
        },
        {
          "id": "confirm_btn_child",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/confirmButtonLabel"
          }
        }
      ],
      "dataModel": {
        "title": "### Delete 3 merged branches?",
        "summary": "The following local branches are merged into `main` and will be deleted:\n\n- `feature/express-worker`\n- `fix/slider-padding`\n- `docs/genui-skill`\n\nRemote tracking refs are left untouched.",
        "confirmLabel": "I understand these branches cannot be recovered from the reflog after 90 days",
        "confirmed": false,
        "confirmButtonLabel": "Delete branches",
        "cancelLabel": "Cancel"
      }
    }
  }
]
