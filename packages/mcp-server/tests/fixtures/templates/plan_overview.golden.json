        {
          "id": "glance_label",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@call": "formatString",
            "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
            "args": {
              "value": "##### ${label}"
            }
          }
        },
        {
          "id": "glance_value",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "value"
          }
        },
        {
          "id": "waves_divider",
          "component": "Divider",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
        },
        {
          "id": "waves_heading",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
