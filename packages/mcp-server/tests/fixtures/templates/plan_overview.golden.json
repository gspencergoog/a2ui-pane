            "@path": "/subtitle"
          },
          "variant": "caption"
        },
        {
          "id": "header_divider",
          "component": "Divider",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
        },
        {
          "id": "glance_list",
          "component": "List",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
