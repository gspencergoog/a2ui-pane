[
  {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "plan_overview",
      "sendDataModel": true,
      "components": [
        {
          "id": "root",
          "component": "Card",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "overview_col"
        },
        {
          "id": "overview_col",
          "component": "Column",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "overview_header",
            "overview_subtitle",
            "header_divider",
            "glance_list",
            "waves_divider",
            "waves_heading",
            "wave_diagram",
            "prs_divider",
            "prs_heading",
            "prs_list",
            "overview_footer"
          ]
        },
        {
          "id": "overview_header",
          "component": "Row",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "overview_title",
            "overview_status"
          ],
          "justify": "spaceBetween",
          "align": "center"
        },
        {
          "id": "overview_title",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
