[
  {
    "version": "v1.0",
    "createSurface": {
      "surfaceId": "comparison_matrix",
      "sendDataModel": true,
      "components": [
        {
          "id": "root",
          "component": "Card",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "matrix_col"
        },
        {
          "id": "matrix_col",
          "component": "Column",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "matrix_title",
            "matrix_question",
            "matrix_table",
            "choice_picker",
            "matrix_notes",
            "matrix_footer"
          ]
        },
        {
          "id": "matrix_title",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/title"
          }
        },
        {
          "id": "matrix_question",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/question"
          }
        },
        {
          "id": "matrix_table",
          "component": "Table",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/status/catalog.json",
          "columns": [
            {
              "key": "criterion",
              "label": "Criterion"
            },
            {
              "key": "o1",
              "label": "1: Templates only",
              "kind": "badge"
            },
            {
              "key": "o2",
              "label": "2: Table first",
              "kind": "badge"
            },
            {
              "key": "o3",
              "label": "3: Hybrid (Recommended)",
              "kind": "badge"
            }
          ],
          "rows": {
            "@path": "/rows"
          }
        },
        {
          "id": "choice_picker",
          "component": "ChoicePicker",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "label": "Pick a sequencing option",
          "variant": "mutuallyExclusive",
          "options": [
            {
              "label": "1: Templates only",
              "value": "o1"
            },
            {
              "label": "2: Table first",
              "value": "o2"
            },
            {
              "label": "3: Hybrid (Recommended)",
              "value": "o3"
            }
          ],
          "value": {
            "@path": "/choice"
          },
          "displayStyle": "chips"
        },
        {
          "id": "matrix_notes",
          "component": "TextField",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "label": "Notes, caveats, or a hybrid",
          "value": {
            "@path": "/notes"
          }
        },
        {
          "id": "matrix_footer",
          "component": "Row",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "children": [
            "submit_btn"
          ],
          "justify": "end",
          "align": "center"
        },
        {
          "id": "submit_btn",
          "component": "Button",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "child": "submit_btn_child",
          "variant": "primary",
          "action": {
            "event": {
              "name": "submit_comparison",
              "context": {
                "choice": {
                  "@path": "/choice"
                },
                "notes": {
                  "@path": "/notes"
                }
              }
            }
          }
        },
        {
          "id": "submit_btn_child",
          "component": "Text",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "text": {
            "@path": "/submitLabel"
          }
        }
      ],
      "dataModel": {
        "title": "### Sequencing the missing genui components",
        "question": "Three ways to order the work. Option 3 is recommended: it ships the two templates that need nothing new first and lands the Table primitive only once the grid templates need it.",
        "rows": [
          {
            "criterion": "Time to first value",
            "o1": {
              "text": "Days",
              "tone": "success"
            },
            "o2": {
              "text": "Weeks",
              "tone": "danger"
            },
            "o3": {
              "text": "Days for the first two",
              "tone": "success"
            }
          },
          {
            "criterion": "PR-tracker coverage",
            "o1": {
              "text": "Partial, links awkward",
              "tone": "warning"
            },
            "o2": {
              "text": "Full",
              "tone": "success"
            },
            "o3": {
              "text": "Full once Link lands",
              "tone": "success"
            }
          },
          {
            "criterion": "Risk",
            "o1": {
              "text": "Templates thrown away later",
              "tone": "warning"
            },
            "o2": {
              "text": "Catalog protocol change",
              "tone": "danger"
            },
            "o3": {
              "text": "Some stack_board rework",
              "tone": "warning"
            }
          },
          {
            "criterion": "Blast radius",
            "o1": {
              "text": "Templates and docs only",
              "tone": "success"
            },
            "o2": {
              "text": "Catalog, renderer, compiler, spec",
              "tone": "danger"
            },
            "o3": {
              "text": "Both, staged",
              "tone": "warning"
            }
          },
          {
            "criterion": "Rework",
            "o1": {
              "text": "Grid templates rebuilt on Table",
              "tone": "danger"
            },
            "o2": {
              "text": "None",
              "tone": "success"
            },
            "o3": {
              "text": "One template, if Table changes layout",
              "tone": "warning"
            }
          }
        ],
        "choice": [
          "o3"
        ],
        "notes": "",
        "submitLabel": "Confirm sequencing"
      }
    }
  }
]
