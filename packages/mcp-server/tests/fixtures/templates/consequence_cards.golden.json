        {
          "id": "more_info_check",
          "component": "CheckBox",
          "label": "Explain further",
          "value": {
            "path": "/moreInfo"
          }
        },
        {
          "id": "defer_check",
          "component": "CheckBox",
          "label": "Park for later",
          "value": {
            "path": "/defer"
          }
        },
        {
          "id": "submit_label",
          "component": "Text",
          "text": {
            "path": "/submitLabel"
          }
        },
        {
          "id": "submit_btn",
          "component": "Button",
          "child": "submit_label",
          "variant": "primary",
          "action": {
            "event": {
              "name": "submit_alignment",
              "context": {
                "choice": {
                  "path": "/choice"
                },
                "notes": {
                  "path": "/notes"
                },
                "moreInfo": {
                  "path": "/moreInfo"
                },
                "defer": {
                  "path": "/defer"
                }
              }
            }
          }
        }
      ]
    }
