// @genui id=plan_overview surface=pane
// @summary Overview of an implementation plan: title and status badge, optional subtitle, stacked At a glance subheadings over prose, an Execution waves Markdown diagram (usually a Mermaid flowchart), a Planned changes list, and a footer with open-question count and primary action button.
// @data /title /subtitle /status /statusTone /glance[] {label,value} /waveDiagram /prsHeading /prs[] {id,title,repo,wave} /openQuestions /ackLabel
// @action acknowledge_plan_overview
// @customize waves_heading ack_btn

$/title = "## Plan Overview"
$/subtitle = ""
$/status = ""
$/statusTone = "neutral"
$/glance = []
$/waveDiagram = ""
$/prsHeading = "### Planned changes"
$/prs = []
$/openQuestions = 0
$/ackLabel = "Acknowledge"

root = Card(overview_col)
overview_col = Column([overview_header, overview_subtitle, header_divider, glance_list, waves_divider, waves_heading, wave_diagram, prs_divider, prs_heading, prs_list, overview_footer])
overview_header = Row([overview_title, overview_status], "spaceBetween", "center")
overview_title = Text($/title, "body", 1)
overview_status = Badge($/status, $/statusTone)
overview_subtitle = Text($/subtitle, "caption")
header_divider = Divider()
glance_list = List(_template($/glance, glance_row))
glance_row = Column([glance_label, glance_value])
glance_label = Text(formatString("##### ${label}"))
glance_value = Text($value)
waves_divider = Divider()
waves_heading = Text("### Execution waves")
wave_diagram = Text($/waveDiagram)
prs_divider = Divider()
prs_heading = Text($/prsHeading)
prs_list = List(_template($/prs, pr_row))
pr_row = Row([pr_body, pr_wave], "spaceBetween", "start")
pr_body = Column([pr_title, pr_meta], _, _, 1)
pr_title = Text(formatString("**${id}.** ${title}"))
pr_meta = Text($repo, "caption")
pr_wave = Text($wave, "caption")
overview_footer = Row([open_questions_text, ack_btn], "spaceBetween", "center")
open_questions_text = Text(formatString("Open questions: ${/openQuestions}"), "caption")
ack_btn = Button(Text($/ackLabel), "primary", Event("acknowledge_plan_overview", {_oneShot: true}))
