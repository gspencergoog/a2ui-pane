// @genui id=decision_batch surface=either
// @summary Batch of short decisions: one card per item with the question, an optional hint, and horizontal ChoiceCards driven by per-item options (for Yes/No/Defer, pass [{value: "yes", label: "Yes"}, {value: "no", label: "No"}, {value: "defer", label: "Defer", quiet: true}]), plus a single shared notes field at the bottom.
// @data /title /intro /items[] {prompt,hint,options,choice} /note /submitLabel
// @action submit_decision_batch
// @customize choice_cards submit_btn

$/title = "### Decisions"
$/intro = "Each item is pre-filled with the recommended answer; change the ones you disagree with."
$/items = []
$/note = ""
$/submitLabel = "Submit decisions"

root = Card(decision_col)
decision_col = Column([decision_title, decision_intro, decision_list, decision_note, decision_divider, decision_footer])
decision_title = Text($/title)
decision_intro = Text($/intro, "caption")
decision_list = List(_template($/items, decision_item_card))
decision_item_card = Card(decision_item_col)
decision_item_col = Column([decision_item_prompt, decision_item_hint, choice_cards])
decision_item_prompt = Text($prompt)
decision_item_hint = Text($hint, "caption")
choice_cards = ChoiceCards($options, $choice, _, "horizontal")
decision_note = TextField("Overall notes or overrides", $/note)
decision_divider = Divider()
decision_footer = Row([submit_btn], "end", "center")
submit_btn = Button(Text($/submitLabel), "primary", Event("submit_decision_batch", {items: $/items, note: $/note}))
