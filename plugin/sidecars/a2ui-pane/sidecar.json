{
  "command": "node",
  "args": ["dist/main.mjs"],
  "restart_policy": "always",
  "display_name": "A2UI Pane",
  "description": "Interactive A2UI surfaces sidecar (built 2026-10-01T15:46:39Z)",
  "has_web_ui": true,
  "env": {
    "A2UI_PANE_DATA": "${PLUGIN_DATA}"
  },
  "ui_config": {
    "display_name": "A2UI Pane",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "A2UI Pane"
      },
      {
        "path": "/?full=1",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_FULL_PANE",
        "title": "A2UI Pane (Full)"
      }
    ]
  }
}
